<% content_for :title, t(".title") %>

<div class="mx-auto max-w-2xl">

  <div class="mb-6">
    <h1 class="text-2xl font-semibold"><%= t(".title") %></h1>
    <p class="text-secondary"><%= t(".description") %></p>
  </div>

  <div class="bg-container rounded-lg p-6 mb-6">
    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-2">
        <h2 class="text-lg font-medium"><%= t(".instructions_title") %></h2>
        <p><%= t(".instructions_description") %></p>
      </div>

      <div class="flex flex-col items-center gap-3 mt-4">
        <button id="launch-yodlee-iframe" type="button" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors">
          <%= t(".connect_button") %> (Embedded)
        </button>
        
        <button id="test-direct-yodlee" type="button" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 transition-colors">
          <%= t(".connect_button") %> (New Window)
        </button>
      </div>
      
      <!-- Container for FastLink iFrame -->
      <div id="fastlink-container" class="mt-4 hidden">
        <div class="text-center text-sm text-gray-500 mb-2">FastLink loaded in iFrame:</div>
        <iframe id="fastlink-iframe" style="width: 100%; height: 600px; border: 1px solid #ccc; border-radius: 8px;"></iframe>
      </div>
    </div>
  </div>

  <div class="text-center text-sm text-secondary mt-4">
    <p><%= t(".privacy_notice") %></p>
  </div>
</div>

<script>
  window.addEventListener('load', function() {
    console.log('Page loaded');
    console.log('FastLink URL:', '<%= @token_response&.fastlink_url || "NO URL" %>');
    console.log('Token:', '<%= @token_response&.user_token ? @token_response.user_token[0..10] + "..." : "NO TOKEN" %>');
    
    // iFrame approach
    const iframeButton = document.getElementById('launch-yodlee-iframe');
    if (iframeButton) {
      iframeButton.onclick = function() {
        console.log('iFrame button clicked!');
        
        const container = document.getElementById('fastlink-container');
        const iframe = document.getElementById('fastlink-iframe');
        const fastlinkUrl = '<%= @token_response&.fastlink_url || "" %>';
        const userToken = '<%= @token_response&.user_token || "" %>';
        
        if (!fastlinkUrl || !userToken) {
          alert('Yodlee configuration missing. Please check your setup.');
          return;
        }
        
        if (container && iframe) {
          // Show the container
          container.classList.remove('hidden');
          
          // Build FastLink URL with parameters
          const iframeUrl = fastlinkUrl + 
            '?accessToken=' + encodeURIComponent(userToken) +
            '&configName=Aggregation';
          
          console.log('Loading FastLink in iFrame:', iframeUrl);
          
          // Add load event listener
          iframe.onload = function() {
            console.log('iFrame loaded successfully');
            iframeButton.textContent = 'FastLink Loaded';
          };
          
          iframe.onerror = function() {
            console.error('iFrame failed to load');
            iframeButton.disabled = false;
            iframeButton.textContent = 'Try Again (iFrame Failed)';
            iframeButton.classList.add('bg-red-600', 'hover:bg-red-700');
            iframeButton.classList.remove('bg-blue-600', 'hover:bg-blue-700');
          };
          
          iframe.src = iframeUrl;
          
          // Disable button temporarily
          iframeButton.disabled = true;
          iframeButton.textContent = 'Loading FastLink...';
        }
      };
    }
    
    // Direct link approach  
    const testButton = document.getElementById('test-direct-yodlee');
    if (testButton) {
      testButton.onclick = function() {
        const fastlinkUrl = '<%= @token_response&.fastlink_url || "" %>';
        const userToken = '<%= @token_response&.user_token || "" %>';
        
        if (!fastlinkUrl || !userToken) {
          alert('Yodlee configuration missing. Please check your setup.');
          return;
        }
        
        // Construct direct URL with corrected parameters
        const directUrl = fastlinkUrl + 
          '?accessToken=' + encodeURIComponent(userToken) +
          '&configName=Aggregation';
          
        console.log('Opening direct URL:', directUrl);
        window.open(directUrl, '_blank', 'width=800,height=600');
      };
    }
  });
</script>